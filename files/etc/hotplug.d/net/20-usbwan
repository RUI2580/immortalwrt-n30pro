#!/bin/sh
# Netcore N30 Pro: auto-bind USB tethering netdev to usbwan interface
#
# netifd only recognises NAMED uci sections (network.usbwan='interface').
# Creating an anonymous section via 'uci add network interface' does not work:
# netifd exposes it as network.interface.cfg<random> and fw4 cannot bind the
# device into the wan zone, so NAT never covers it.

[ "$ACTION" = add ] || exit 0
[ -n "$INTERFACE" ] || exit 0

case "$DEVTYPE" in
	rndis_host|rndis_wlan|cdc_ether|cdc_ncm|cdc_eem)
		;;
	*)
		exit 0
		;;
esac

logger -t usbwan-hotplug "USB netdev $INTERFACE (devtype=$DEVTYPE) attached"

# Create/maintain the NAMED interface section.
if [ "$(uci -q get network.usbwan)" != "interface" ]; then
	uci -q delete network.usbwan 2>/dev/null
	uci set network.usbwan='interface'
	uci set network.usbwan.proto='dhcp'
	uci set network.usbwan.metric='20'
fi

if [ "$(uci -q get network.usbwan.device)" != "$INTERFACE" ]; then
	uci set network.usbwan.device="$INTERFACE"
fi

# Ensure it belongs to the wan firewall zone (for NAT/forwarding).
if ! uci -q get firewall.@zone[1].network 2>/dev/null | grep -qw usbwan; then
	for i in $(seq 0 15); do
		[ "$(uci -q get firewall.@zone[$i].name)" = "wan" ] || continue
		uci add_list firewall.@zone[$i].network='usbwan'
		break
	done
	uci commit firewall
	FW_CHANGED=1
fi

uci commit network

# Let the USB link settle, then hand the device over to netifd for DHCP.
sleep 2
ubus call network.interface.usbwan down >/dev/null 2>&1 || true
ubus call network.interface.usbwan up >/dev/null 2>&1 || true

# Reload firewall so fw4 re-scans zone devices and picks up the new netdev.
if [ -n "$FW_CHANGED" ]; then
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
fi

logger -t usbwan-hotplug "usbwan brought up on $INTERFACE"
